import { Theme } from "theme.slint";

// ---------------------------------------------------------------------------
// Primitives
// ---------------------------------------------------------------------------

// 24-unit stroke icon ported from the web SVG set.
export component Icon inherits Path {
    in property <color> tint: Theme.text-dim;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.7px;
    viewbox-width: 24;
    viewbox-height: 24;
}

// Pill: solid light-on-dark emphasis (codes, counts).
export component Plate inherits Rectangle {
    in property <string> label: "";
    in property <bool> quiet: false;
    background: root.quiet ? transparent : Theme.text;
    animate background { duration: 110ms; easing: ease-out; }
    border-width: root.quiet ? 1px : 0px;
    border-color: Theme.border;
    border-radius: self.height / 2;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            color: root.quiet ? Theme.text-dim : Theme.accent-fg;
            font-family: "Cascadia Mono";
            font-size: 11.5px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component HLine inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// Text button: quiet by default, accent-filled when primary.
export component Btn inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> danger-fill: false;
    in property <bool> enabled: true;
    in property <bool> mono: false;
    in property <length> font-size: 13px;
    callback clicked();
    min-height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.danger-fill ? Theme.danger
                 : root.primary ? Theme.accent
                 : (ta.has-hover ? Theme.border-strong : Theme.border);
    opacity: root.enabled ? 1 : 0.4;
    background: root.danger-fill ? (ta.pressed ? Theme.danger.darker(10%) : Theme.danger)
              : root.primary ? (ta.pressed ? Theme.accent.darker(10%) : Theme.accent)
              : (ta.has-hover ? Theme.hover : transparent);
    transform-scale-x: ta.pressed ? 0.97 : 1.0;
    transform-scale-y: ta.pressed ? 0.97 : 1.0;
    animate transform-scale-x { duration: 90ms; easing: ease-out; }
    animate transform-scale-y { duration: 90ms; easing: ease-out; }
    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }
    animate opacity { duration: 110ms; easing: ease-out; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.label;
            color: root.danger-fill ? #FFFFFF
                 : root.primary ? Theme.accent-fg
                 : (root.danger ? Theme.danger : Theme.text);
            font-family: root.mono ? "Cascadia Mono" : "Arial";
            font-size: root.font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Square icon button (card actions, topbar, window controls).
export component IconBtn inherits Rectangle {
    in property <string> commands: "";
    in property <color> tint: Theme.text-dim;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> framed: false;
    in property <length> size: 32px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.framed
        ? (root.active ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border))
        : (root.active ? Theme.accent : (ta.has-hover ? Theme.border-strong : transparent));
    opacity: root.enabled ? 1 : 0.35;
    background: root.framed
        ? Theme.surface-2
        : (root.active ? Theme.accent
        : ta.has-hover ? (root.danger ? Theme.danger : Theme.hover)
        : transparent);
    transform-scale-x: ta.pressed ? 0.97 : 1.0;
    transform-scale-y: ta.pressed ? 0.97 : 1.0;
    animate transform-scale-x { duration: 90ms; easing: ease-out; }
    animate transform-scale-y { duration: 90ms; easing: ease-out; }
    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }
    animate opacity { duration: 110ms; easing: ease-out; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        size: root.size / 2;
        commands: root.commands;
        tint: root.active
            ? (root.framed ? Theme.accent : Theme.accent-fg)
            : ta.has-hover && root.danger ? #FFFFFF
            : ta.has-hover ? Theme.text
            : root.tint;
    }
}

// Tab: label + count pill; the active tab is a solid light block.
export component Tab inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Theme.text : Theme.border;
    background: root.active ? Theme.text : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.accent-fg : Theme.text-dim;
            animate color { duration: 150ms; easing: ease-out; }
            font-family: "Arial";
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Topbar bridge trigger: one button, brand icon centred, state dot as a badge.
export component StatusIconBtn inherits Rectangle {
    in property <string> commands: "";
    in property <color> tint: Theme.text;
    in property <string> state: "checking";
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 7px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-strong : transparent;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        size: 18px;
        commands: root.commands;
        tint: ta.has-hover ? root.tint : root.tint.mix(Theme.text-dim, 0.35);
    }
    // status badge
    Rectangle {
        x: root.width - 12px;
        y: 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.window-bg;
        background: root.state == "ok" ? Theme.ok : Theme.text-faint;
        animate background { duration: 180ms; easing: ease-out; }
    }
}

// Custom select (matches a dark combobox).
export component Pick inherits Rectangle {
    in property <string> value: "";
    in property <bool> enabled: true;
    in property <bool> open: false;
    callback clicked();
    height: 34px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: root.open ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border);
    animate border-color { duration: 150ms; easing: ease-out; }
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.4;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 11px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.value;
        color: (root.enabled && ta.has-hover) ? Theme.text : Theme.text-dim;
        animate color { duration: 150ms; easing: ease-out; }
        font-family: "Arial";
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Path {
        x: parent.width - 20px;
        y: 14px;
        width: 10px;
        height: 6px;
        fill: transparent;
        stroke: Theme.text-dim;
        animate stroke { duration: 150ms; easing: ease-out; }
        stroke-width: 1.4px;
        commands: "M 1 1 L 5 5 L 9 1";
    }
}

// Uppercase mono tag chip.
export component TagChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> removable: false;
    callback clicked();
    callback removed();
    min-height: 22px;
    background: ta.has-hover ? Theme.hover : Theme.surface-2;
    animate background { duration: 110ms; easing: ease-out; }
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-strong : Theme.border;
    animate border-color { duration: 110ms; easing: ease-out; }
    border-radius: 5px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-family: "Arial";
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.2px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.removable : Rectangle {
            width: 14px;
            background: transparent;
            close-ta := TouchArea {
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                mouse-cursor: pointer;
                clicked => { root.removed(); }
            }
            Path {
                x: (parent.width - 12px) / 2;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                fill: transparent;
                stroke: close-ta.has-hover ? Theme.danger : Theme.text-faint;
                animate stroke { duration: 110ms; easing: ease-out; }
                stroke-width: 1.7px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5";
            }
        }
    }
}

// 0..100 slider for the Settings sheet. std-widgets' Slider draws in the active
// widget style (a fixed palette that ignores these tokens and looks wrong in
// either theme); this one is drawn entirely from Theme.
export component GlassSlider inherits Rectangle {
    in-out property <float> value: 50;
    callback slid(float);

    height: 24px;
    // The knob travels the track's width minus its own size; fill and knob both
    // derive from this single position so they can never disagree.
    property <length> knob-x: (clamp(root.value, 0, 100) / 100) * max(0px, root.width - 14px);

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 6px;
        border-radius: 3px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        // The fill grows from the LEFT edge. `x: 0` is load-bearing: Slint's
        // default_geometry centres a child that sets its own width without an
        // `x` (`maybe_center_in_parent`), which drew the filled part of the
        // track in the middle instead of left-to-right.
        Rectangle {
            x: 0;
            y: 0;
            width: root.knob-x + 7px;
            height: parent.height;
            background: Theme.accent;
            animate width { duration: 80ms; easing: ease-out; }
        }
    }
    Rectangle {
        x: root.knob-x;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.text;
        border-width: 1px;
        border-color: Theme.border-strong;
    }
    drag := TouchArea {
        mouse-cursor: pointer;
        // The pointer position comes from TouchArea's own `mouse-x` (a
        // PointerEvent carries no coordinates), so it maps straight from the
        // pointer position to the value.
        function pick-from(px: length) {
            root.value = clamp(100 * px / max(1px, self.width), 0, 100);
            root.slid(root.value);
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button != PointerEventButton.left) { return EventResult.reject; }
                self.pick-from(self.mouse-x);
                return EventResult.accept;
            }
            if ((event.kind == PointerEventKind.move || event.kind == PointerEventKind.up) && self.pressed) {
                self.pick-from(self.mouse-x);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

// Shared dialog chrome: eyebrow + display title + close (X).
export component DialogHead inherits Rectangle {
    in property <string> eyebrow: "";
    in property <string> title: "";
    callback closed();
    height: 74px;
    background: transparent;
    VerticalLayout {
        padding-left: 20px;
        padding-right: 14px;
        padding-top: 13px;
        padding-bottom: 13px;
        spacing: 6px;
        Text {
            text: root.eyebrow;
            font-family: "Cascadia Mono";
            font-size: 10px;
            letter-spacing: 1.4px;
            color: Theme.text-faint;
            height: 12px;
            vertical-alignment: center;
        }
        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Text {
                text: root.title;
                font-family: "Haettenschweiler";
                font-size: 26px;
                letter-spacing: -0.5px;
                color: Theme.text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            IconBtn {
                size: 30px;
                commands: "M 5 5 L 19 19 M 19 5 L 5 19";
                clicked => { root.closed(); }
            }
        }
    }
}

// Connection state card: dot + message + recheck.
export component BridgeStatus inherits Rectangle {
    in property <string> state: "checking";
    in property <string> text: "";
    callback recheck();
    height: 50px;
    background: transparent;
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 10px;
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 16px;
                padding-right: 14px;
                spacing: 12px;
                Rectangle {
                    width: 10px;
                    Rectangle {
                        y: (parent.height - 10px) / 2;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.state == "ok" ? Theme.ok : Theme.text-faint;
                        animate background { duration: 180ms; easing: ease-out; }
                    }
                }
                Text {
                    text: root.text;
                    font-family: "Arial";
                    font-size: 13px;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Btn {
            width: 92px;
            label: "Recheck";
            font-size: 13px;
            clicked => { root.recheck(); }
        }
    }
}

// Caption + text input.
export component DialogField inherits VerticalLayout {
    in property <string> caption: "";
    in-out property <string> value: "";
    callback edited(string);
    spacing: 6px;
    Text {
        text: root.caption;
        font-family: "Cascadia Mono";
        font-size: 10px;
        letter-spacing: 1.2px;
        color: Theme.text-faint;
        height: 14px;
        vertical-alignment: center;
    }
    Rectangle {
        height: 36px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
        animate border-color { duration: 150ms; easing: ease-out; }
        border-radius: 6px;
        TextInput {
            x: 12px;
            y: 0px;
            width: parent.width - 24px;
            height: parent.height;
            text <=> root.value;
            color: Theme.text;
            font-family: "Cascadia Mono";
            font-size: 12px;
            single-line: true;
            vertical-alignment: center;
            edited => { root.edited(self.text); }
        }
    }
}

// ---------------------------------------------------------------------------
// Asset card
// ---------------------------------------------------------------------------
export component Card inherits Rectangle {
    in property <string> code: "";
    in property <string> slug: "";
    in property <image> thumb;
    in property <string> t1: "";
    in property <string> t2: "";
    in property <string> t3: "";
    in property <bool> in-cart: false;
    in property <bool> in-unity: false;
    in property <int> kind: 0; // 0 model, 1 material, 2 rig
    callback open();
    callback cart();
    callback copy();
    callback blender();
    callback tag(string);

    background: root.in-cart ? Theme.surface-2 : (hover.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: 1px;
    border-color: (hover.has-hover || root.in-cart) ? Theme.border-strong : Theme.border;
    border-radius: 8px;
    transform-scale-x: (hover.has-hover || root.in-cart) ? 1.012 : 1.0;
    transform-scale-y: (hover.has-hover || root.in-cart) ? 1.012 : 1.0;
    animate transform-scale-x { duration: 180ms; easing: ease-out; }
    animate transform-scale-y { duration: 180ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }
    animate background { duration: 150ms; easing: ease-out; }
    clip: true;

    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }

    VerticalLayout {
        spacing: 0px;
        well := Rectangle {
            height: self.width;
            background: Theme.well;
            clip: true;
            Image {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                source: root.thumb;
                image-fit: contain;
            }
        }
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 8px;
            HorizontalLayout {
                height: 26px;
                spacing: 6px;
                Rectangle {
                    width: 14px;
                    height: parent.height;
                    background: transparent;
                    Rectangle {
                        y: (parent.height - 8px) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.in-unity ? #22D96B : Theme.text-dim;
                    }
                }
                Text {
                    text: root.slug;
                    font-family: "Cascadia Mono";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    height: parent.height;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                height: 26px;
                spacing: 2px;
                IconBtn {
                    size: 26px;
                    commands: root.in-cart ? "M 4.6 12.6 L 9.4 17.4 L 19.4 6.8" : "M 12 5.5 L 12 18.5 M 5.5 12 L 18.5 12";
                    active: root.in-cart;
                    clicked => { root.cart(); }
                }
                IconBtn {
                    size: 26px;
                    commands: "M 9 9 L 20.5 9 L 20.5 20.5 L 9 20.5 Z M 5.5 15 L 5.5 5.5 L 15 5.5";
                    clicked => { root.copy(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.kind != 1 : Rectangle {
                    width: 62px;
                    height: 26px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.blender;
                    background: blender-ta.has-hover ? Theme.blender.transparentize(0.88) : transparent;
                    animate background { duration: 110ms; easing: ease-out; }
                    blender-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.blender(); }
                    }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "Blender";
                        color: Theme.blender;
                        font-family: "Arial";
                        font-size: 10.5px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component CartTile inherits Rectangle {
    in property <image> thumb;
    in property <string> code: "";
    callback open();
    callback remove();

    // Square preview-only card; the remove control only appears on hover.
    height: self.width;
    border-radius: 8px;
    background: Theme.well;
    border-width: 1px;
    border-color: hover.has-hover ? Theme.border-strong : Theme.border;
    animate border-color { duration: 120ms; easing: ease-out; }
    clip: true;

    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    Image {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        source: root.thumb;
        image-fit: contain;
    }
    if hover.has-hover : IconBtn {
        x: parent.width - 34px;
        y: 8px;
        size: 26px;
        commands: "M 6 6 L 18 18 M 18 6 L 6 18";
        danger: true;
        clicked => { root.remove(); }
    }
}


// Full-window dismiss layer: left-click (on release) or right-click closes the
// panel above it. Declared before the panel so the panel sits on top.
export component ModalScrim inherits TouchArea {
    callback dismissed();
    width: 100%;
    height: 100%;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
            root.dismissed();
            return EventResult.accept;
        }
        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
            root.dismissed();
            return EventResult.accept;
        }
        return EventResult.accept;
    }
}

// Click barrier inside a panel. It swallows clicks and closes the panel on a
// right-click, so a right-click anywhere on the sheet dismisses it too.
export component ModalSurface inherits TouchArea {
    callback dismissed();
    width: 100%;
    height: 100%;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
            root.dismissed();
        }
        return EventResult.accept;
    }
}

// Collapsible first-level section header used by the detail pane.
export component SectionHead inherits Rectangle {
    in property <string> label: "";
    in property <bool> open: true;
    callback toggled();
    height: 30px;
    background: ta.has-hover ? Theme.hover : transparent;
    border-radius: 5px;
    animate background { duration: 110ms; easing: ease-out; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    HorizontalLayout {
        padding-left: 0px;
        padding-right: 0px;
        spacing: 8px;
        Text {
            text: root.label;
            font-family: "Arial";
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.4px;
            color: Theme.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Path {
            width: 14px;
            height: 14px;
            fill: transparent;
            stroke: Theme.text-dim;
            stroke-width: 1.8px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.open ? "M 5 9 L 12 16 L 19 9" : "M 9 5 L 16 12 L 9 19";
        }
    }
}
